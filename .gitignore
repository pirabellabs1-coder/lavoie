# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel — le dossier de liaison, et ses copies de sauvegarde
.vercel*

# typescript
*.tsbuildinfo
next-env.d.ts

# Documents et images de travail déposés à la racine — rapports, CV, photos,
# PDF clients. Ils n'ont rien à faire dans un dépôt public : les images du site
# vivent dans public/, les documents éditoriaux dans src/lib/. La règle ne vaut
# qu'à la racine (le « / » initial), pour ne jamais masquer un vrai fichier du
# projet. Un fichier légitime s'ajoute malgré tout avec « git add -f ».
/*.pdf
/*.doc
/*.docx
/*.odt
/*.xls
/*.xlsx
/*.ppt
/*.pptx
/*.csv
/*.zip
/*.jpg
/*.jpeg
/*.png
/*.gif
/*.webp
/*.heic
/*.mp4
/*.mov
